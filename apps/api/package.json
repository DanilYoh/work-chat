    "@nestjs/core": "latest",
    "@nestjs/platform-fastify": "latest",
    "@nestjs/swagger": "latest",
    "@work-chat/contracts": "workspace:*",
    "fastify": "5.10.0",
    "jose": "latest",
    "nats": "latest",
    "pg": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@nestjs/testing": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "supertest": "latest",
    "tsx": "latest",
    "vitest": "latest"
  }
